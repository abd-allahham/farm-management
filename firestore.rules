rules_version = '2';

// Single farm, single/testing user for now: any authenticated user has full
// access. A `role` field + per-farm scoping can be layered on to these rules
// later without a data model rewrite (see README).
service cloud.firestore {
  match /databases/{database}/documents {
    match /yards/{yardId} {
      allow read, write: if request.auth != null;
    }

    match /vaccines/{vaccineId} {
      allow read, write: if request.auth != null;
    }

    match /cows/{cowId} {
      // Create/full edit (barcode/birthDate/yardId) go through the
      // createCow/updateCow callables (Admin SDK, bypasses these rules) so
      // the vaccination fan-out runs server-side in the same request — see
      // functions/src/cows.ts. Slaughter/delete (M5) are plain field-scoped
      // client writes since they have no fan-out to run.
      allow read: if request.auth != null;
      allow create, delete: if false;
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'slaughteredAt', 'deletedAt']);

      match /vaccinations/{vaccineId} {
        // "vaccinate a cow" (M5): the client may only flip status/takenAt —
        // everything else here (dueDate, birthDate) is server-managed.
        allow read: if request.auth != null;
        allow create, delete: if false;
        allow update: if request.auth != null &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'takenAt']);
      }
    }

    // Not defined yet — deny by default until each collection is opened up
    // explicitly, same pattern as yards/vaccines/cows above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
