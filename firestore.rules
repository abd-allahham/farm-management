rules_version = '2';

// Single farm, single/testing user for now: any authenticated user has full
// access. A `role` field + per-farm scoping can be layered on to these rules
// later without a data model rewrite (see README).
service cloud.firestore {
  match /databases/{database}/documents {
    match /yards/{yardId} {
      allow read, write: if request.auth != null;
    }

    match /vaccines/{vaccineId} {
      allow read, write: if request.auth != null;
    }

    // cows/{cowId} and its vaccinations/{vaccineId} subcollection are still
    // written only by Cloud Functions (Admin SDK bypasses these rules) until
    // M3 gives the client its own cows collection to read/write.

    // Not defined yet — deny by default until each collection is opened up
    // explicitly, same pattern as yards/vaccines above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
