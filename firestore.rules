rules_version = '2';

// Single farm, single/testing user for now: any authenticated user has full
// access. A `role` field + per-farm scoping can be layered on to these rules
// later without a data model rewrite (see README).
service cloud.firestore {
  match /databases/{database}/documents {
    match /yards/{yardId} {
      allow read, write: if request.auth != null;
    }

    match /vaccines/{vaccineId} {
      allow read, write: if request.auth != null;
    }

    match /cows/{cowId} {
      allow read, write: if request.auth != null;

      // Populated by Cloud Functions (Admin SDK, bypasses these rules).
      // Client can read to show the checklist; "vaccinate a cow" (M5) is
      // the only client write these should ever need.
      match /vaccinations/{vaccineId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // Not defined yet — deny by default until each collection is opened up
    // explicitly, same pattern as yards/vaccines/cows above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
